---
import Layout from '../../layouts/Layout.astro';
import Row from '../../components/Row.astro';
import Tree from '../../components/Tree.astro';
import Swimlane from '../../components/Swimlane.astro';
import { snap, tok, min, when, cut, headline, isEmptyDone, md, allMembers } from '../../lib/snap';
export function getStaticPaths() {
  return snap.projects.map((p: any) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const members = allMembers(p.tree);
const active = members.filter((m: any) => m.state === '進んでいる');
const messages = p.timeline.filter((e: any) => e.group === 'message' && !isEmptyDone(e));
const head = headline(p);
const top = messages.filter((e: any) => !e.component || e.component === p.id);
const teamIds = [...new Set(messages.filter((e: any) => e.component && e.component !== p.id).map((e: any) => e.component))] as string[];
const byTeam = teamIds.map((id) => ({ id, title: (function f(c: any): any { return c.id === id ? c : c.children.map(f).find(Boolean); })(p.tree)?.title ?? id, events: messages.filter((e: any) => e.component === id) }));
const c = p.counts;
---
<Layout title={p.title}>
  <h2>{p.title} <span class={`tag ${p.status}`}>{p.status === 'open' ? '動いている' : '閉じた'}</span></h2>
  <p class="lead small">{p.id}・{min(p.duration_min)}・{when(p.created_at)}〜{p.closed_at ? when(p.closed_at) : ''}</p>

  <div class="stats">
    <div class="stat"><b>{active.length}</b><span>動いているメンバー</span></div>
    <div class="stat"><b>{members.length}</b><span>関わったメンバー</span></div>
    <div class="stat"><b>{c.round_trips}</b><span>往復</span></div>
    <div class={`stat ${c.remakes ? 'alert' : ''}`}><b>{c.remakes}</b><span>作り直し（指摘 {c.review_ng}・差し戻し {c.rework}）</span></div>
    <div class="stat"><b>{p.tokens_total === null ? '—' : tok(p.tokens_total)}</b><span>トークン</span></div>
  </div>


  <h3>誰がどう動いたか</h3>
  <Swimlane p={p} />

  <h3>{p.status === 'closed' ? '結果' : 'いまの最後の報告'}</h3>
  {head ? (
    <details>
      <summary><span class={`tag ${head.kind}`}>{head.kind}</span> <b>{p.status === 'closed' ? '結果' : 'いまの最後の報告'}</b> <span class="mute small">{when(head.ts)}・{cut(head.summary, 60)}</span></summary>
      <div class="body md" set:html={md(head.body)} />
    </details>
  ) : null}

  <h3>組織の形</h3>
  <Tree c={p.tree} />

  <h3>やりとりの中身</h3>
  <p class="mute small">プロジェクトの層（PM と川崎さん・チーム間）のやりとりを並べ、チームの中のやりとりはチームごとに畳む。</p>
  {top.map((e: any) => <Row e={e} />)}
  {byTeam.map((t) => (
    <details>
      <summary><b>{t.title}</b> <span class="mute small">チームの中のやりとり {t.events.length} 件</span></summary>
      <div class="body">{t.events.map((e: any) => <Row e={e} />)}</div>
    </details>
  ))}
</Layout>
