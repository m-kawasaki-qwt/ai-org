---
import Layout from '../layouts/Layout.astro';
import { snap, tok, min } from '../lib/snap';
const p = snap.performance;
const maxTok = Math.max(1, ...p.by_project.map((r: any) => r.tokens_total ?? 0));
const maxTokPos = Math.max(1, ...p.by_position.map((r: any) => r.tokens_total ?? 0));
const rt = p.by_project.reduce((a: number, r: any) => a + r.round_trips, 0);
const rm = p.by_project.reduce((a: number, r: any) => a + r.remakes, 0);
---
<Layout title="パフォーマンス">
  <h2>パフォーマンス</h2>
  <p class="lead">全体: トークン {tok(snap.totals.tokens_total)}・往復 {rt}・作り直し {rm}。「—（片づけ前）」は開いていて報告が無いもの（0 ではない）。</p>
  {[['プロジェクトごと', p.by_project, maxTok], ['立場ごと', p.by_position, maxTokPos]].map(([label, rows, mx]: any) => (
    <>
      <h3>{label}</h3>
      <table>
        <thead><tr><th>{label === '立場ごと' ? '立場' : 'プロジェクト'}</th><th class="n">セッション</th><th class="n">時間</th><th class="n">トークン</th><th style="width:25%"></th><th class="n">1 セッション</th><th class="n">往復</th><th class="n">作り直し</th></tr></thead>
        <tbody>
          {rows.map((r: any) => (
            <tr>
              <td>{r.key}{!r.metrics_complete ? <div class="mute">一部のみ</div> : null}</td>
              <td class="n">{r.sessions}</td>
              <td class="n">{min(r.span_min_total)}</td>
              <td class="n">{tok(r.tokens_total)}</td>
              <td>{r.tokens_total ? <div class="bar" style={`width:${(r.tokens_total / mx) * 100}%`}></div> : null}</td>
              <td class="n">{tok(r.tokens_per_session)}</td>
              <td class="n">{r.round_trips}</td>
              <td class="n">{r.remakes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))}
  <h3>セッションごと</h3>
  {p.sessions.map((s: any) => (
    <details>
      <summary>{s.member_id} <span class="mute">— {s.position}・{s.model}・{min(s.span_min)}・{tok(s.tokens_total)}</span></summary>
      <div class="body"><p class="mute">API メッセージ {s.api_messages ?? '—'}・review_ng {s.review_ng_count}・送信 {Object.entries(s.events_sent).map(([k, v]) => `${k}×${v}`).join(' ') || '—'}</p>
      {s.tokens ? <p class="mute">input {tok(s.tokens.input)}・output {tok(s.tokens.output)}・cache_read {tok(s.tokens.cache_read)}・cache_write {tok(s.tokens.cache_write)}</p> : null}</div>
    </details>
  ))}
</Layout>
