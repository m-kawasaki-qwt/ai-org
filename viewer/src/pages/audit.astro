---
import Layout from '../layouts/Layout.astro';
import { snap, when } from '../lib/snap';
const props = snap.audit_proposals;
const unclear = snap.unclear;
const grp = (key: (u: any) => string) => {
  const m = new Map<string, any[]>();
  for (const u of unclear) m.set(key(u), [...(m.get(key(u)) ?? []), u]);
  return [...m.entries()];
};
const byProject = grp((u) => u.project);
const byPosition = grp((u) => u.position).map(([k, v]: any) => [k, v.length]);
---
<Layout title="監査・unclear">
  <h2>監査の改訂案と unclear</h2>
  <p class="lead">改訂案 {snap.totals.audit_proposal_count} 件・決まりで分からなかった点 {snap.totals.unclear_count} 件。</p>
  <h3>監査の改訂案</h3>
  {props.length === 0 ? <p class="mute">監査の報告はありません。</p> : null}
  {props.map((r: any) => (
    <>
      <p><b>{r.project}</b> <span class="mute">{r.from}・{when(r.ts)}{r.parsed ? '' : '・項目を取れず本文全体'}</span></p>
      {r.proposals.map((x: any) => (
        <details>
          <summary>{x.number !== null ? `${x.number}. ` : ''}<b>{x.title}</b>{x.target ? <span class="mute"> — {x.target}</span> : null}</summary>
          <pre>{x.body}</pre>
        </details>
      ))}
      <details><summary class="mute">報告の全文（観察を含む）</summary><pre>{r.report_body}</pre></details>
    </>
  ))}
  <h3>unclear（セッション報告から）</h3>
  <p class="mute">プロジェクトごとの件数。開くと中身。</p>
  {unclear.length === 0 ? <p class="mute">ありません。</p> : null}
  <div class="stats">
    {byProject.map(([id, items]: any) => <div class="stat"><b>{items.length}</b><span>{id}</span></div>)}
  </div>
  <div class="stats">
    {byPosition.map(([id, n]: any) => <div class="stat"><b>{n}</b><span>{id}</span></div>)}
  </div>
  {byProject.map(([id, items]: any) => (
    <details>
      <summary><b>{id}</b> <span class="mute">— {items.length} 件</span></summary>
      <table>
        <thead><tr><th>誰</th><th>分からなかった点</th></tr></thead>
        <tbody>
          {items.map((u: any) => (
            <tr><td>{u.position}<div class="mute">{u.member_id.replace(id + '/', '')}</div></td><td>{u.text}<div class="mute">{u.report}</div></td></tr>
          ))}
        </tbody>
      </table>
    </details>
  ))}
</Layout>
