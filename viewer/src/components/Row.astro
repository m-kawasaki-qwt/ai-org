---
import { when, cut, md, leaf } from '../lib/snap';
const { e, open } = Astro.props;
---
<details id={`e-${e.id}`} class={e.unread ? 'unread' : ''} open={open}>
  <summary>
    <span class="mute nowrap small">{when(e.ts)}</span>
    <span class={`tag ${e.kind}`}>{e.kind}</span>
    <span class="nowrap">{leaf(e.from)} → {leaf(e.to)}</span>
    <span>{cut(e.summary, 90)}</span>
  </summary>
  <div class="body">
    {e.body ? <div class="md" set:html={md(e.body)} /> : <p class="mute">本文なし。</p>}
    {e.msg ? <div class="mute small">{e.msg}</div> : null}
  </div>
</details>
